# Copia para .env. Estes valores são PÚBLICOS por design (a anon key do Supabase
# foi feita para viver no cliente; a segurança vem das policies + edge functions).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL base das edge functions (a "camada API"). Normalmente:
# https://your-project-ref.supabase.co/functions/v1
EXPO_PUBLIC_API_URL=https://your-project-ref.supabase.co/functions/v1
