# Secrets das edge functions.
# Localmente: copia para supabase/functions/.env e usa `supabase functions serve`.
# Em produção: define com `supabase secrets set --env-file supabase/functions/.env`
#
# NOTA: SUPABASE_URL e SUPABASE_ANON_KEY são injetados automaticamente pela
# plataforma — não precisas de os definir aqui.

# Sanity (sanity.io/manage)
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
# Token com permissão de Editor/escrita. NUNCA vai para a app — só aqui.
SANITY_API_TOKEN=your-sanity-write-token
